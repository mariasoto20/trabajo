<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="Content-Security-Policy" 
        content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' https: data:; connect-src 'self' ws://localhost:* http://localhost:* chrome-extension:;">
  <title><%= titulo %></title>
  
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Devicon CDN para iconos de habilidades técnicas -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.15.1/devicon.min.css">
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <!-- CARRUSEL SUPERIOR -->
  <section class="hero-carousel" id="inicio">
    <button class="carousel-btn prev-btn" id="prevBtn">&#10094;</button>
    
    <div class="carousel-track" id="carouselTrack">
      <% proyectos.forEach((proyecto) => { %>
        <article class="carousel-slide">
          <img src="<%= proyecto.imagen %>" alt="<%= proyecto.titulo %>">
          <div class="carousel-caption">
            <h3><%= proyecto.titulo %></h3>
            <p><%= proyecto.descripcion %></p>
          </div>
        </article>
      <% }); %>
    </div>

    <button class="carousel-btn next-btn" id="nextBtn">&#10095;</button>
  </section>

  <!-- MENÚ RESPONSIVO -->
  <nav class="side-menu">
    <a href="#inicio" title="Inicio"><i class="fas fa-home"></i></a>
    <a href="#sobre-mi" title="Sobre Mí"><i class="fas fa-user"></i></a>
    <a href="#habilidades" title="Habilidades"><i class="fas fa-code"></i></a>
    <a href="#proyectos" title="Proyectos"><i class="fa-solid fa-server"></i></a>
    <a href="#contacto" title="Contacto"><i class="fas fa-envelope"></i></a>
  </nav>

  <!-- CONTENIDO PRINCIPAL -->
  <main>
    <!-- SOBRE MÍ -->
    <section id="sobre-mi">
      <h2>Sobre Nosotros</h2>
      <div class="profile-gallery">
        <% fotosPerfil.forEach((foto, index) => { %>
          <div class="profile-card">
            <img src="<%= foto %>" alt="Foto de perfil <%= index + 1 %>">
          </div>
        <% }); %>
      </div>
    </section>

    <!-- HABILIDADES -->
    <section id="habilidades">
      <div class="skills-section">
        <h2>Habilidades Técnicas</h2>
        
        <div class="skills-container">
          <div class="skill-card">
            <i class="devicon-nodejs-plain colored"></i>
            <h3>Node.js</h3>
            <p>Entorno de ejecución para el desarrollo backend escalable.</p>
          </div>

          <div class="skill-card">
            <i class="devicon-express-original colored"></i>
            <h3>Express</h3>
            <p>Framework rápido para creación de APIs RESTful.</p>
          </div>

          <div class="skill-card">
            <i class="devicon-javascript-plain colored"></i>
            <h3>JavaScript</h3>
            <p>Lógica del lado del cliente y servidor con ES6+.</p>
          </div>

          <div class="skill-card">
            <i class="devicon-php-plain colored"></i>
            <h3>PHP</h3>
            <p>Desarrollo web dinámico e integración en el servidor.</p>
          </div>

          <div class="skill-card">
            <i class="devicon-codeigniter-plain colored"></i>
            <h3>CodeIgniter 4</h3>
            <p>Framework PHP bajo arquitectura MVC limpia y ágil.</p>
          </div>

          <div class="skill-card">
            <i class="devicon-mysql-plain colored"></i>
            <h3>MySQL</h3>
            <p>Diseño y gestión de bases de datos relacionales.</p>
          </div>

          <div class="skill-card">
            <i class="devicon-firebase-plain colored"></i>
            <h3>Firebase</h3>
            <p>Cloud Firestore y servicios de autenticación.</p>
          </div>

          <div class="skill-card">
            <i class="devicon-flutter-plain colored"></i>
            <h3>Flutter</h3>
            <p>Desarrollo de aplicaciones móviles multiplataforma.</p>
          </div>

          <div class="skill-card">
            <i class="devicon-git-plain colored"></i>
            <h3>Git</h3>
            <p>Control de versiones y gestión de código con GitHub.</p>
          </div>
        </div>
      </div> 
    </section>
    <!-- GALERÍA DE PROYECTOS -->
    <section id="proyectos">
      <h2>Galería De Proyectos</h2>
     <button class="btn-preview-image" onclick="openLightbox(['images/asistencia/1.png', 'images/asistencia/2.png', 'images/asistencia/3.png','images/asistencia/4.png'])">

        <img src="images/asistencia/1.png" alt="Vista previa del proyecto">
        <div class="overlay">
         <i class="fas fa-search-plus"></i>
            <span>Ver Vistas Previas</span>
          </div>
          </button>

      <!-- LIGHTBOX MODAL -->
      <div id="lightboxModal" class="lightbox-modal">
        <span class="close-btn" onclick="closeLightbox()">&times;</span>
        <button class="nav-btn prev-btn" onclick="changeImage(-1)">&#10094;</button>
        
        <div class="lightbox-content">
          <img id="lightboxImg" src="" alt="Vista previa del proyecto">
          <div id="lightboxCaption" class="lightbox-caption"></div>
        </div>

        <button class="nav-btn next-btn" onclick="changeImage(1)">&#10095;</button>
      </div>
    </section>

    <!-- CONTACTO -->
    <section id="contacto">
      <h2>Contacto</h2>
      <p style="text-align: center;">¿Tienes una propuesta o proyecto? Escríbeme a tuemail@ejemplo.com</p>
    </section>
  </main>

  <footer>
    <p>&copy; 2026 <%= nombre %>. Todos los derechos reservados.</p>
  </footer>

  <!-- LÓGICA JAVASCRIPT -->
  <script>
    // --- LÓGICA DEL CARRUSEL ---
    const track = document.getElementById('carouselTrack');
    const slides = Array.from(track.children);
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    let carouselIndex = 0;

    function updateCarousel() {
      track.style.transform = `translateX(-${carouselIndex * 100}%)`;
    }

    if (slides.length > 0) {
      nextBtn.addEventListener('click', () => {
        carouselIndex = (carouselIndex + 1) % slides.length;
        updateCarousel();
      });

      prevBtn.addEventListener('click', () => {
        carouselIndex = (carouselIndex - 1 + slides.length) % slides.length;
        updateCarousel();
      });

      setInterval(() => {
        carouselIndex = (carouselIndex + 1) % slides.length;
        updateCarousel();
      }, 5000);
    }

    // --- LÓGICA DEL LIGHTBOX (GALERÍA MODAL) ---
    let currentImages = [];
    let lightboxIndex = 0;

    function openLightbox(imagesArray) {
      currentImages = imagesArray;
      lightboxIndex = 0;
      updateLightboxImage();
      document.getElementById('lightboxModal').classList.add('active');
    }

    function closeLightbox() {
      document.getElementById('lightboxModal').classList.remove('active');
    }

    function changeImage(direction) {
      lightboxIndex += direction;
      
      if (lightboxIndex >= currentImages.length) {
        lightboxIndex = 0;
      } else if (lightboxIndex < 0) {
        lightboxIndex = currentImages.length - 1;
      }
      
      updateLightboxImage();
    }

    function updateLightboxImage() {
      const imgElement = document.getElementById('lightboxImg');
      const captionElement = document.getElementById('lightboxCaption');
      
      imgElement.src = currentImages[lightboxIndex];
      captionElement.textContent = `Imagen ${lightboxIndex + 1} de ${currentImages.length}`;
    }

    // Navegación con teclado
    document.addEventListener('keydown', (e) => {
      const modal = document.getElementById('lightboxModal');
      if (!modal.classList.contains('active')) return;

      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') changeImage(1);
      if (e.key === 'ArrowLeft') changeImage(-1);
    });
  </script>

</body>
</html>